# Streamlit Cloud: App settings → Secrets (dán nội dung tương tự)
# Local: sao chép thành secrets.toml (file này không được commit)

# Cách 1: Dán trực tiếp chuỗi JSON cấu hình Firebase:
FIREBASE_CONFIG = '''{
  "apiKey": "AIzaSy...",
  "authDomain": "my-app.firebaseapp.com",
  "projectId": "my-app-12345",
  "storageBucket": "my-app.appspot.com",
  "messagingSenderId": "1234567890",
  "appId": "1:1234567890:web:abcdef..."
}'''

# Hoặc Cách 2: Từng khóa riêng lẻ:
# FIREBASE_API_KEY = "AIzaSy..."
# FIREBASE_PROJECT_ID = "my-app-12345"
# FIREBASE_AUTH_DOMAIN = "my-app.firebaseapp.com"
# FIREBASE_APP_ID = "1:1234567890:web:abcdef..."
